{
  "name": "artshape-sound",
  "version": "0.2.0",
  "description": "Sound effects and music for a browser game, synthesised from a few numbers at load so that no sound file is downloaded.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audio": "vitest run --config vitest.audio.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:quick": "prettier --check . --log-level warn && npm run --silent typecheck && eslint . && vitest run --reporter dot",
    "check": "npm run --silent check:quick && npm run --silent test:audio && npm run --silent size && npm run --silent bench",
    "sheet": "vite sheet --port 5182 --strictPort",
    "playground": "vite playground --port 5183 --strictPort",
    "prepare": "git config core.hooksPath .githooks || true",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/bench.mjs --log-level=warning && node node_modules/.cache/scripts/bench.mjs",
    "size": "esbuild scripts/size.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/scripts/size.mjs --log-level=warning && node node_modules/.cache/scripts/size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
